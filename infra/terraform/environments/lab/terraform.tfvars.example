# Sao chép thành terraform.tfvars nếu cần tùy chỉnh. File .example không tự được nạp.
# Không đặt credentials, token hoặc password trong file variables.
aws_region         = "ap-southeast-1"
environment        = "lab"
vpc_cidr           = "10.20.0.0/16"
public_subnet_cidr = "10.20.1.0/24"
instance_type      = "t4g.small"

tags = {
  Owner = "johnny"
}
